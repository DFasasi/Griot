{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Griot",
  "version": "0.1.0",
  "identifier": "app.griot.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Griot",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "Turn any set of songs into a seamless album"
  }
}
