# Copy to .env (never committed) and fill in what you need. Everything is optional.

# Library import
SPOTIFY_CLIENT_ID=          # public id; sign-in uses PKCE, so no client secret exists here
YOUTUBE_API_KEY=

# Catalog enrichment
LASTFM_API_KEY=
ACOUSTID_API_KEY=
ANTHROPIC_API_KEY=
JAMENDO_CLIENT_ID=          # also: modal secret create jamendo JAMENDO_CLIENT_ID=...

# Wiring
DATABASE_URL=               # e.g. postgresql://griot:griot@localhost:5432/griot (docker compose)
GRIOT_API_URL=http://127.0.0.1:8000
# Shared secret between analyzers (TOKEN) and the API (TOKENS, comma-separated). Generate:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
GRIOT_SUBMIT_TOKEN=
GRIOT_SUBMIT_TOKENS=
